# Mewser Gateway Configuration Template
# Place this file at /etc/mewser-gateway/gateway.env with permissions 0600 (owner: root:root).
#
# Generate a cryptographically secure 64-character token using:
#   openssl rand -hex 32
#
# DO NOT COMMIT REAL TOKENS OR SECRETS TO SOURCE CONTROL.

# [Required] Secret Bearer token for client authentication
# Clients must include this token in the 'Authorization: Bearer <token>' header.
MEWSER_GATEWAY_AUTH_TOKEN=REPLACE_WITH_GENERATED_64_CHAR_HEX_TOKEN

# [Optional] Enforce authentication requirement (defaults to true).
# In production, this must always be true.
MEWSER_GATEWAY_REQUIRE_AUTH=true

# [Required] Local socket address to bind.
#
# Topology 1 (Recommended): Dedicated MasterDNS Fixed TCP Mode
# Bind strictly to server loopback. MasterDNS forwards incoming requests locally.
# Zero external network exposure.
MEWSER_GATEWAY_BIND=127.0.0.1:4040
MEWSER_GATEWAY_ALLOW_NON_LOOPBACK=false

# Topology 2: MasterDNS SOCKS5 Mode with Firewall Isolation
# Bind to the server's public IPv4 address because MasterDNS upstream SOCKS5 rejects
# loopback and private IP destinations.
# WARNING: When using this topology, MEWSER_GATEWAY_ALLOW_NON_LOOPBACK=true is required,
# AND you MUST configure the host firewall to reject all non-loopback inbound traffic:
#   iptables -I INPUT 1 ! -i lo -p tcp --dport 4040 -j REJECT --reject-with tcp-reset
# Failure to configure firewall isolation exposes plain HTTP extraction to the public internet!
#
# MEWSER_GATEWAY_BIND=YOUR_SERVER_PUBLIC_IP:4040
# MEWSER_GATEWAY_ALLOW_NON_LOOPBACK=true
